# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI por AI Gateway).
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad.
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
# Secreto: déjalo vacío aquí.
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway). El token es secreto.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo.
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Producción y acceso.
# development o production; con production se aplican las reglas de
# doc/compliance-checklist.md y el producto no arranca si alguna falla.
ENVIRONMENT=development
# Secreto: una entrada cliente:clave por cliente, separadas por comas. Déjalo vacío
# aquí y escribe las claves reales solo en tu .env o en Render. En producción cada
# clave debe tener 16 caracteres o más.
API_KEYS=
# Peticiones por cliente por minuto.
RATE_LIMIT_PER_MINUTE=30
