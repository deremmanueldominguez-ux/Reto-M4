# Secretos: .env nunca se sube; .env.example sí, porque no tiene valores.
.env
.env.*
!.env.example

# Entornos virtuales.
.venv/
venv/

# Cachés de Python y de las herramientas.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pylint.d/
.mypy_cache/
.ruff_cache/

# Cobertura.
.coverage
.coverage.*
htmlcov/

# Resultados de Playwright.
test-results/
